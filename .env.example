# Live Expression Reader — environment template
# Copy to `.env.local` for local dev. Vite only exposes VITE_-prefixed vars to the client.
# Reminder: this app is static + browser-side. Production routes LLM calls through a
# serverless proxy that holds the API key — the browser bundle never sees it.

# -- LLM proxy (used by the "Why?" / Ask / Summarize features) --
# PRODUCTION: point this at a tiny serverless proxy (e.g. Cloudflare Worker)
# that holds the real API key as a server-side secret. The browser bundle
# never sees the key. Add per-IP rate limiting in the proxy.
VITE_EXPLAIN_PROXY_URL=

# LOCAL DEV ONLY: embeds the key in the JS bundle, fine on localhost but a
# leak in any deployed build. Leave EMPTY when building for production.
# Set a hard monthly spend cap on this key in the provider dashboard regardless.
VITE_DEMO_ANTHROPIC_API_KEY=

# Model id for the explainer (literal API model identifier).
VITE_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# -- Models / assets --
# MediaPipe FaceLandmarker (~10MB, blendshapes + landmarks).
VITE_MEDIAPIPE_MODEL_URL=https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/latest/face_landmarker.task

# HSEmotion enet_b0_8_va_mtl ONNX (~16MB, 8 emotions + V/A, Apache-2.0).
# Default points at the GitHub source via jsdelivr CDN; mirror to HF Hub for production.
VITE_HSEMOTION_MODEL_URL=https://cdn.jsdelivr.net/gh/HSE-asavchenko/face-emotion-recognition@main/models/affectnet_emotions/onnx/enet_b0_8_va_mtl.onnx

# -- Feature flags --
# "A" = MediaPipe-only (legacy). "B" = MediaPipe + HSEmotion ONNX (current default).
VITE_PIPELINE_VARIANT=B
